{
  "projectType": "webapp",
  "devServer": {
    "command": "pnpm",
    "args": [
      "run",
      "dev",
      "--",
      "--host",
      "127.0.0.1"
    ],
    "url": "http://127.0.0.1:5173/"
  },
  "setup": [
    {
      "command": "pnpm",
      "args": [
        "install",
        "--frozen-lockfile"
      ]
    }
  ],
  "assertions": [
    {
      "name": "tsc-no-emit",
      "kind": "process",
      "command": "pnpm",
      "args": [
        "exec",
        "tsc",
        "--noEmit"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "dev-server-serves-home",
      "kind": "http-probe",
      "startCommand": "pnpm",
      "startArgs": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "url": "http://127.0.0.1:5173/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
